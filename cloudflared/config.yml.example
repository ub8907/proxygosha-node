# Example Cloudflare Tunnel configuration for ProxyGosha Node.js
# Replace <TUNNEL_UUID> and tg.yourdomain.com with your own tunnel ID and domain.

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: tg.yourdomain.com
    service: http://127.0.0.1:3000
    originRequest:
      noTLSVerify: true
      keepAliveConnections: 100
      keepAliveTimeout: 90s
  - service: http_status:404
