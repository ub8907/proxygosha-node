# ==============================================================================
# 运行平台预留环境变量（ProxyGosha 代理功能本身不使用以下两项，部署时可忽略或留空）
# ==============================================================================

# GEMINI_API_KEY：用于调用 Gemini AI 接口的密钥（仅平台模板默认预留，本项目未调用 AI 接口）
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL：当前应用在托管平台上的访问地址（仅平台模板默认预留，ProxyGosha 会自动从请求头识别真实域名）
APP_URL="MY_APP_URL"

# ==============================================================================
# ProxyGosha Node.js / Express 核心配置
# ==============================================================================

# 服务监听端口与绑定地址（Cloudflare Tunnel 默认回源到 127.0.0.1:3000）
PORT=3000
HOST=0.0.0.0

# 必填：管理面板访问路径密码及默认密钥派生种子（至少 16 位字符）
# 访问 https://你的域名/<ADMIN_KEY> 查看代理链接，/<ADMIN_KEY>/status 查看实时状态与 DC 探测
ADMIN_KEY="eoeijjwbjyihbvhq"

# 可选：固定 32 位十六进制代理密钥（或 dd + 32 位十六进制）
# 若留空，将由 ADMIN_KEY 确定性派生；注意：未设置 SECRET 时修改 ADMIN_KEY 会使旧链接失效
SECRET=""

# 可选：允许访问的域名白名单（多个域名用英文逗号分隔，默认 "*" 允许所有域名，包括隧道域名）
HOSTNAME="*"
EXTRA_HOSTS=""

# 可选：WebSocket 传输载体模式（"websocket-lanes" 为每条流独立连接，推荐；"websocket" 为单连接多路复用）
CARRIER="websocket-lanes"

# 可选：单个 WebSocket 会话允许的最大并发 MTProto 流数量（范围 1-64）
MAX_STREAMS=16

# 可选：自定义会话握手与 WebSocket 通信路径（默认一般无需修改）
SESSION_PATH="/api/v1/session"
WS_PATH="/api/v1/ws"

# 可选：反探测伪装上游网站 URL（例如 "https://example.com"；留空则使用内置 LUXVEIL 商城伪装页）
DECOY_URL=""

# 可选：Middle-End 广告标签（32 位十六进制，Direct-DC 模式下仅作保留配置）
AD_TAG=""

# 可选：兼容旧版按域名动态派生 Secret 接口开关（默认关闭）
GENERATOR_ENABLED="false"
GENERATOR_KEY=""
ACCEPT_GENERATED="false"

# 可选：是否开启调试日志（"true" 或 "1" 开启）
DEBUG="false"

# 可选：Cloudflare Tunnel 隧道 Token（用于 docker-compose 伴随容器或开启自动拉起托管）
CF_TUNNEL_TOKEN=""
CF_TUNNEL_AUTOSTART="false"
