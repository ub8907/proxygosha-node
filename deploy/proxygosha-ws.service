[Unit]
Description=ProxyGosha PHP Workerman WebSocket Engine
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/proxygosha
Environment=WORKERMAN_PORT=3001
Environment=WORKERMAN_HOST=127.0.0.1
ExecStart=/usr/bin/php /var/www/proxygosha/start.php start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
