# Node.js Express + WebSocket 服务监听端口与绑定地址
PORT=3000
HOST=0.0.0.0

# 必填：管理面板访问路径密钥（至少 16 位英文、数字、- 或 _，请妥善保管）
ADMIN_KEY=""

# 可选：固定 32 位十六进制 Secret（或 dd+32位）；留空则自动从 ADMIN_KEY 确定性派生
SECRET=""

# 可选：传输载体模式（websocket-lanes 推荐 | websocket）
CARRIER="websocket-lanes"

# 可选：允许访问的域名白名单（逗号分隔；留空或 * 表示允许所有域名）
# 注意：使用 ALLOWED_HOSTS 可避免与 Linux/Docker 系统自带的 HOSTNAME 环境变量冲突
ALLOWED_HOSTS="*"

# 可选：额外允许域名（逗号分隔，多域名或 CDN 加速回源时使用）
EXTRA_HOSTS=""

# 可选：自定义伪装上游站点 URL（留空使用内置 LUXVEIL 时尚商城）
DECOY_URL=""

# 可选：Telegram 数据中心出站尝试端口顺序（默认 443,80,5222）
DC_PORTS="443,80,5222"

# 可选：单条 WebSocket 会话最大并发流数量（1–64）
MAX_STREAMS=16
