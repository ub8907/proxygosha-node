# Nginx 对外网站监听端口（供 cloudflared 指向 http://127.0.0.1:3000）
PORT=3000
HOST=0.0.0.0

# 后台 Workerman WebSocket 引擎监听端口与内部遥测查询地址（搭配 Nginx + PHP-FPM index.php 使用）
WORKERMAN_PORT=3001
WORKERMAN_HOST=127.0.0.1
WORKERMAN_INTERNAL_URL="http://127.0.0.1:3001"
WORKER_COUNT=1

# 必填：管理面板访问路径密钥（至少 16 位英文、数字、- 或 _，请妥善保管）
ADMIN_KEY=""

# 可选：固定 32 位十六进制 Secret（或 dd+32位）；留空则自动从 ADMIN_KEY 确定性派生
SECRET=""

# 可选：传输载体模式（websocket-lanes 推荐 | websocket）
CARRIER="websocket-lanes"

# 可选：允许访问的域名白名单（逗号分隔；留空或 * 表示允许所有隧道域名）
# 注意：使用 ALLOWED_HOSTS 可避免与 Linux/Docker 系统自带的 HOSTNAME 环境变量冲突
ALLOWED_HOSTS="*"

# 可选：额外允许域名（逗号分隔，多个隧道域名时使用）
EXTRA_HOSTS=""

# 可选：自定义伪装上游站点 URL（留空使用内置 LUXVEIL 时尚商城）
DECOY_URL=""

# 可选：Telegram 数据中心出站尝试端口顺序（默认 443,80,5222）
DC_PORTS="443,80,5222"

# 可选：单条 WebSocket 会话最大并发流数量（1–64）
MAX_STREAMS=16

# 可选：Cloudflare Tunnel Token 与自动拉起开关
CF_TUNNEL_TOKEN=""
CF_TUNNEL_AUTOSTART=false
