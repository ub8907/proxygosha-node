# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# ProxyGosha Node.js / Express Configuration
# ==============================================================================

# Server listen port & bind host (Cloudflare Tunnel forwards to 127.0.0.1:3000)
PORT=3000
HOST=0.0.0.0

# Required: Admin panel secret path & key derivation password (min 16 chars)
# Visit https://your-domain.com/<ADMIN_KEY> for links, /<ADMIN_KEY>/status for diagnostics
ADMIN_KEY=""

# Optional: Fixed 32-char hex (or dd + 32-char hex) proxy secret.
# If omitted, derived deterministically from ADMIN_KEY.
SECRET=""

# Optional: Comma-separated allowed hostnames (e.g. "tg.example.com,alt.example.com" or "*")
HOSTNAME="*"
EXTRA_HOSTS=""

# Optional: Carrier transport mode ("websocket-lanes" or "websocket")
CARRIER="websocket-lanes"

# Optional: Max concurrent MTProto streams per WebSocket session (1-64)
MAX_STREAMS=16

# Optional: Custom HTTP paths
SESSION_PATH="/api/v1/session"
WS_PATH="/api/v1/ws"

# Optional: Real website URL to reverse-proxy as anti-probing camouflage
DECOY_URL=""

# Optional: Middle-End Ad Tag (32-char hex)
AD_TAG=""

# Optional: Legacy domain-derived secret generator flags
GENERATOR_ENABLED="false"
GENERATOR_KEY=""
ACCEPT_GENERATED="false"

# Optional: Debug logging ("true" or "1")
DEBUG="false"

# Optional: Cloudflare Tunnel token (if running cloudflared sidecar or auto-launcher)
CF_TUNNEL_TOKEN=""
CF_TUNNEL_AUTOSTART="false"
